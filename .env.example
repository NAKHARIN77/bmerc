# Copy to apps/api/.env for local development. Never commit real secrets.
# Runtime connection: non-owner role, so Row-Level Security always applies.
DATABASE_URL="postgresql://bmerc_app:bmerc_app_dev@localhost:5432/bmerc?schema=public"
# Migrations and seed: table owner.
MIGRATE_DATABASE_URL="postgresql://bmerc:bmerc_dev@localhost:5432/bmerc?schema=public"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="dev-only-secret-change-me-0123456789"
# Comma list or Express "trust proxy" value for the proxies in front of the API (the web app in dev).
TRUST_PROXY="loopback"
