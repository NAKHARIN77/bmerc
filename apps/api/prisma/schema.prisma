// BMERC database schema. Source of truth: docs/system-design.html section 5.
// Every tenant table carries company_id; Row-Level Security policies are added in a SQL migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Platform tables ─────────────

enum CompanyStatus {
  active
  suspended
  closed
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
}

enum InvoiceStatus {
  open
  paid
  void
}

enum Role {
  company_admin
  site_manager // sees only the sites linked in user_sites (any number of sites)
  head_technician
  technician
  stock_keeper // stock and jobs only at the sites linked in user_sites
}

model Company {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  legalName      String?       @map("legal_name")
  taxId          String?       @map("tax_id")
  billingEmail   String?       @map("billing_email")
  billingAddress String?       @map("billing_address")
  timezone       String        @default("Asia/Bangkok")
  country        String? // ISO 3166-1 alpha-2; decides the VAT on plan invoices. Required at signup.
  currency       String        @default("USD") // ISO 4217, for repair invoices to the company's own customers
  taxRateBps     Int           @default(0) @map("tax_rate_bps") // tax on repair invoices, basis points (700 = 7%)
  status         CompanyStatus @default(active)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  subscription Subscription?
  invoices     Invoice[]
  users        User[]
  customers    Customer[]
  sites        Site[]
  teams        Team[]
  devices      Device[]
  jobs         Job[]
  parts        Part[]
  auditLogs    AuditLog[]
  counters     Counter[]

  @@map("companies")
}

model Plan {
  id              String  @id @default(uuid()) @db.Uuid
  code            String  @unique // trial | basic | pro
  name            String
  priceCents      Int     @map("price_cents")
  currency        String  @default("USD")
  maxJobsPerMonth Int?    @map("max_jobs_per_month") // null = unlimited
  maxSites        Int?    @map("max_sites")
  maxUsers        Int?    @map("max_users")
  features        Json    @default("[]")
  isActive        Boolean @default(true) @map("is_active")

  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @unique @map("company_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(trialing)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  overrideLimits     Json?              @map("override_limits") // "Edit limits" screen

  company Company @relation(fields: [companyId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  number         String        @unique // INV-2026-011
  periodStart    DateTime      @map("period_start")
  periodEnd      DateTime      @map("period_end")
  amountCents    Int           @map("amount_cents")
  taxRateBps     Int           @default(0) @map("tax_rate_bps") // VAT rate used, by company country
  taxCents       Int           @default(0) @map("tax_cents")
  currency       String        @default("USD")
  status         InvoiceStatus @default(open) // never delete; void instead
  dueAt          DateTime      @map("due_at")
  paidAt         DateTime?     @map("paid_at")
  // Plan this invoice pays for. Paying an invoice for another plan moves the company to it (plan change).
  planId         String?       @map("plan_id") @db.Uuid
  paymentRef     String?       @map("payment_ref") // PayPal / card / BTC reference
  // Phase 1: company uploads a transfer slip, platform owner confirms (mark-paid).
  slipUrl        String?       @map("slip_url")
  slipUploadedAt DateTime?     @map("slip_uploaded_at")
  confirmedById  String?       @map("confirmed_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  plan    Plan?   @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@map("invoices")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String?   @map("company_id") @db.Uuid // null for platform admin
  email           String    @unique
  passwordHash    String?   @map("password_hash") // null until an invited user sets a password
  fullName        String    @map("full_name")
  role            Role?
  teamId          String?   @map("team_id") @db.Uuid
  isActive        Boolean   @default(true) @map("is_active")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  company       Company?       @relation(fields: [companyId], references: [id])
  team          Team?          @relation("TeamMembers", fields: [teamId], references: [id])
  headOfTeams   Team[]         @relation("TeamHead")
  refreshTokens RefreshToken[]
  tokens        UserToken[]
  assignedJobs  Job[]          @relation("JobAssignee")
  siteLinks     UserSite[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum UserTokenType {
  invite
  password_reset
}

// One-time links sent by email. Only the SHA-256 hash is stored.
model UserToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  type        UserTokenType
  tokenHash   String        @unique @map("token_hash")
  expiresAt   DateTime      @map("expires_at")
  usedAt      DateTime?     @map("used_at")
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

// Append-only. A trigger in the RLS migration blocks UPDATE and DELETE.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  companyId   String?  @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ───────────── Tenant tables (company_id on every row) ─────────────

enum SiteStatus {
  setup
  active
  inactive
}

enum JobStatus {
  todo
  in_repair
  waiting_parts
  unrepairable
  qc_passed
  dispatched
}

enum JobPriority {
  low
  normal
  high
  urgent
}

enum ComponentResult {
  repaired
  replaced
  unchanged
}

enum StockMovementType {
  in
  out
  adjust
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  contactName String?  @map("contact_name")
  email       String?
  phone       String?
  country     String?
  createdAt   DateTime @default(now()) @map("created_at")

  company Company  @relation(fields: [companyId], references: [id])
  devices Device[]
  jobs    Job[]

  @@index([companyId])
  @@map("customers")
}

// A branch of the repair center. Customers ship devices in; no on-site repair (design doc Q1).
model Site {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  name      String
  country   String?
  province  String?
  address   String?
  status    SiteStatus @default(setup)
  createdAt DateTime   @default(now()) @map("created_at")

  company        Company         @relation(fields: [companyId], references: [id])
  teams          Team[]
  jobs           Job[]
  stock          SiteStock[]
  stockMovements StockMovement[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transfersIn    StockTransfer[] @relation("TransferTo")
  userLinks      UserSite[]

  partRequests PartRequest[]

  @@index([companyId])
  @@map("sites")
}

// Sites a site_manager or stock_keeper works at. One person may cover many sites.
model UserSite {
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
  @@index([companyId])
  @@index([siteId])
  @@map("user_sites")
}

model Team {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  siteId     String   @map("site_id") @db.Uuid
  name       String
  headUserId String?  @map("head_user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])
  head    User?   @relation("TeamHead", fields: [headUserId], references: [id])
  members User[]  @relation("TeamMembers")

  @@index([companyId])
  @@map("teams")
}

enum DeviceKind {
  miner // whole machine
  hashboard
  control_board
  psu
  other
}

// What a customer sends in: a whole miner or a single board / PSU. History is looked up by serial.
model Device {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  customerId   String     @map("customer_id") @db.Uuid
  kind         DeviceKind @default(miner)
  model        String // e.g. Antminer S19 Pro, or the board model for a single board
  serialNo     String     @map("serial_no")
  hashrateTh   Decimal?   @map("hashrate_th") @db.Decimal(10, 2)
  qrCode       String?    @unique @map("qr_code") // random, e.g. BMERC-7K3QX9MD; issued at first QC pass
  // The catalog model this device is, when picked from the list at intake (model above keeps the name).
  minerModelId String?    @map("miner_model_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")

  company    Company     @relation(fields: [companyId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  minerModel MinerModel? @relation(fields: [minerModelId], references: [id])
  jobs       Job[]

  @@unique([companyId, kind, serialNo])
  @@index([companyId, serialNo])
  @@map("devices")
}

model Job {
  id                 String      @id @default(uuid()) @db.Uuid
  companyId          String      @map("company_id") @db.Uuid
  number             String // TK-2026-0113, sequential per company via counters
  deviceId           String      @map("device_id") @db.Uuid
  customerId         String      @map("customer_id") @db.Uuid
  siteId             String      @map("site_id") @db.Uuid
  assigneeId         String?     @map("assignee_id") @db.Uuid
  status             JobStatus   @default(todo)
  priority           JobPriority @default(normal)
  reportedFault      String?     @map("reported_fault")
  workNote           String?     @map("work_note")
  unrepairableReason String?     @map("unrepairable_reason")
  receivedAt         DateTime    @default(now()) @map("received_at")
  qcPassedAt         DateTime?   @map("qc_passed_at")
  dispatchedAt       DateTime?   @map("dispatched_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  company     Company         @relation(fields: [companyId], references: [id])
  device      Device          @relation(fields: [deviceId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  site        Site            @relation(fields: [siteId], references: [id])
  assignee    User?           @relation("JobAssignee", fields: [assigneeId], references: [id])
  events      JobEvent[]
  components  JobComponent[]
  parts       JobPart[]
  qrPrintLogs QrPrintLog[]
  tests       JobTest[]
  movements   StockMovement[]
  invoice     JobInvoice?

  partRequests PartRequest[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("jobs")
}

// ───────────── Repair billing (customer pays the repair center) ─────────────
// Separate from `invoices`, which bill the company for its BMERC plan.
// Phase 1: bank transfer + slip upload, confirmed by staff. Gateway webhooks come later.

enum JobInvoiceStatus {
  unpaid
  partial
  paid
  void
}

enum JobInvoiceLineKind {
  labor
  part
  other
}

enum PaymentMethod {
  bank_transfer
  cash
  other
}

enum PaymentStatus {
  pending // slip uploaded, waiting for staff review
  confirmed
  rejected
}

model JobInvoice {
  id            String           @id @default(uuid()) @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  jobId         String           @unique @map("job_id") @db.Uuid
  number        String // RI-2026-0042, sequential per company via counters (key rinv:2026)
  currency      String // copied from the company when the invoice is created
  taxRateBps    Int              @default(0) @map("tax_rate_bps") // copied from the company
  subtotalCents Int              @map("subtotal_cents")
  taxCents      Int              @default(0) @map("tax_cents")
  totalCents    Int              @map("total_cents")
  paidCents     Int              @default(0) @map("paid_cents") // sum of confirmed payments
  status        JobInvoiceStatus @default(unpaid) // never delete; void instead
  issuedAt      DateTime         @default(now()) @map("issued_at")
  dueAt         DateTime?        @map("due_at")
  note          String?
  createdById   String?          @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  job      Job              @relation(fields: [jobId], references: [id])
  lines    JobInvoiceLine[]
  payments JobPayment[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("job_invoices")
}

model JobInvoiceLine {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  invoiceId      String             @map("invoice_id") @db.Uuid
  kind           JobInvoiceLineKind
  description    String
  qty            Decimal            @default(1) @db.Decimal(10, 2)
  unitPriceCents Int                @map("unit_price_cents")
  amountCents    Int                @map("amount_cents")
  jobPartId      String?            @map("job_part_id") @db.Uuid // set when the line bills a part used in the job
  sortOrder      Int                @default(0) @map("sort_order")

  invoice JobInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("job_invoice_lines")
}

model JobPayment {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  invoiceId     String        @map("invoice_id") @db.Uuid
  method        PaymentMethod @default(bank_transfer)
  amountCents   Int           @map("amount_cents")
  paidAt        DateTime      @map("paid_at") // date on the slip / when cash was received
  reference     String? // bank transaction ref
  slipUrl       String?       @map("slip_url")
  status        PaymentStatus @default(pending)
  submittedById String?       @map("submitted_by_id") @db.Uuid
  reviewedById  String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?     @map("reviewed_at")
  rejectReason  String?       @map("reject_reason")
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice JobInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("job_payments")
}

model JobEvent {
  id         BigInt     @id @default(autoincrement())
  companyId  String     @map("company_id") @db.Uuid
  jobId      String     @map("job_id") @db.Uuid
  fromStatus JobStatus? @map("from_status")
  toStatus   JobStatus  @map("to_status")
  actorId    String?    @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime   @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("job_events")
}

model JobComponent {
  id                  String          @id @default(uuid()) @db.Uuid
  companyId           String          @map("company_id") @db.Uuid
  jobId               String          @map("job_id") @db.Uuid
  component           String // e.g. "Hashboard 2", "Control board"
  // Serials of boards worked on inside a whole miner, so a board sent in alone later still shows its history.
  serialNo            String?         @map("serial_no") // the board that was in the machine
  replacementSerialNo String?         @map("replacement_serial_no") // the board fitted instead, when result = replaced
  workDone            String?         @map("work_done")
  result              ComponentResult

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([companyId, serialNo])
  @@index([companyId, replacementSerialNo])
  @@map("job_components")
}

model Part {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  sku       String
  name      String
  category  String?
  // Miner models this part fits (miner_models ids). Empty means it fits any model (fans, thermal paste).
  modelIds  String[] @default([]) @map("model_ids") @db.Uuid
  unit      String   @default("pcs")
  minQty    Int      @default(0) @map("min_qty")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  company   Company         @relation(fields: [companyId], references: [id])
  stock     SiteStock[]
  movements StockMovement[]
  transfers StockTransfer[]
  jobParts  JobPart[]

  requests PartRequest[]

  @@unique([companyId, sku])
  @@map("parts")
}

// Current balance. CHECK (qty >= 0) is added in the RLS migration.
model SiteStock {
  companyId String @map("company_id") @db.Uuid
  siteId    String @map("site_id") @db.Uuid
  partId    String @map("part_id") @db.Uuid
  qty       Int    @default(0)

  site Site @relation(fields: [siteId], references: [id])
  part Part @relation(fields: [partId], references: [id])

  @@id([siteId, partId])
  @@map("site_stock")
}

// Stock ledger. Append-only.
model StockMovement {
  id        BigInt            @id @default(autoincrement())
  companyId String            @map("company_id") @db.Uuid
  siteId    String            @map("site_id") @db.Uuid
  partId    String            @map("part_id") @db.Uuid
  type      StockMovementType
  qty       Int // signed: + in, - out
  jobId     String?           @map("job_id") @db.Uuid
  reason    String?
  actorId   String?           @map("actor_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")

  site     Site      @relation(fields: [siteId], references: [id])
  part     Part      @relation(fields: [partId], references: [id])
  job      Job?      @relation(fields: [jobId], references: [id])
  jobParts JobPart[]

  @@index([companyId, partId])
  @@map("stock_movements")
}

model JobPart {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  jobId      String @map("job_id") @db.Uuid
  partId     String @map("part_id") @db.Uuid
  qty        Int
  movementId BigInt @map("movement_id")

  job      Job           @relation(fields: [jobId], references: [id])
  part     Part          @relation(fields: [partId], references: [id])
  movement StockMovement @relation(fields: [movementId], references: [id])

  @@index([jobId])
  @@map("job_parts")
}

// Bench test before QC (prototype "Test record"): each board, PSU and fans pass, fail or not tested.
// All pass moves the job to qc_passed; any fail keeps it in repair. Kept as a log, newest wins.
model JobTest {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  testedOn   DateTime @map("tested_on") @db.Date
  testedById String   @map("tested_by_id") @db.Uuid
  workDone   String?  @map("work_done")
  results    Json // { hb1: "pass" | "fail" | "not_tested", hb2, hb3, ctrl, psu, fan }
  passed     Boolean
  createdAt  DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("job_tests")
}

model QrPrintLog {
  id        BigInt   @id @default(autoincrement())
  companyId String   @map("company_id") @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  printedBy String   @map("printed_by") @db.Uuid
  copies    Int      @default(1)
  printedAt DateTime @default(now()) @map("printed_at")

  job Job @relation(fields: [jobId], references: [id])

  @@map("qr_print_logs")
}

// Job number sequence per company, locked with SELECT ... FOR UPDATE.
model Counter {
  companyId String @map("company_id") @db.Uuid
  key       String // e.g. job:2026
  value     Int    @default(0)

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, key])
  @@map("counters")
}

enum StockTransferStatus {
  in_transit
  received
  cancelled
}

// Parts sent from one site to another: the sender books them out, the receiving site confirms arrival
// (decided 2026-11-22). Cancelling while in transit books them back in at the sending site.
model StockTransfer {
  id         String              @id @default(uuid()) @db.Uuid
  companyId  String              @map("company_id") @db.Uuid
  fromSiteId String              @map("from_site_id") @db.Uuid
  toSiteId   String              @map("to_site_id") @db.Uuid
  partId     String              @map("part_id") @db.Uuid
  qty        Int
  status     StockTransferStatus @default(in_transit)
  note       String?
  sentById   String              @map("sent_by_id") @db.Uuid
  sentAt     DateTime            @default(now()) @map("sent_at")
  closedById String?             @map("closed_by_id") @db.Uuid
  closedAt   DateTime?           @map("closed_at")

  fromSite Site @relation("TransferFrom", fields: [fromSiteId], references: [id])
  toSite   Site @relation("TransferTo", fields: [toSiteId], references: [id])
  part     Part @relation(fields: [partId], references: [id])

  @@index([companyId, status])
  @@map("stock_transfers")
}

// Reference list of miner models with their hashboards and chips, kept by the platform owner for every company.
// Used at intake, when choosing parts for a job and when recording which boards were worked on.
// verified = the platform owner checked the numbers against a real unit or the maker's sheet.
model MinerModel {
  id            String   @id @default(uuid()) @db.Uuid
  brand         String
  name          String   @unique
  hashboards    Int      @default(3)
  chipModel     String?  @map("chip_model")
  chipsPerBoard Int?     @map("chips_per_board")
  hashrateTh    Decimal? @map("hashrate_th") @db.Decimal(10, 2)
  notes         String?
  sourceUrl     String?  @map("source_url")
  verified      Boolean  @default(false)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  devices Device[]

  @@map("miner_models")
}

enum PartRequestStatus {
  pending
  approved
  rejected
  cancelled
}

// A technician asks for parts for a job; the stock keeper (or a lead) approves it, which takes the parts
// out of the job's site stock and puts them on the job, or rejects it with a reason (decided 2026-11-24).
model PartRequest {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  jobId         String            @map("job_id") @db.Uuid
  siteId        String            @map("site_id") @db.Uuid
  partId        String            @map("part_id") @db.Uuid
  qty           Int
  note          String?
  status        PartRequestStatus @default(pending)
  requestedById String            @map("requested_by_id") @db.Uuid
  decidedById   String?           @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?         @map("decided_at")
  decisionNote  String?           @map("decision_note")
  jobPartId     String?           @map("job_part_id") @db.Uuid // the parts put on the job when approved
  createdAt     DateTime          @default(now()) @map("created_at")

  job  Job  @relation(fields: [jobId], references: [id])
  site Site @relation(fields: [siteId], references: [id])
  part Part @relation(fields: [partId], references: [id])

  @@index([companyId, status])
  @@index([jobId])
  @@map("part_requests")
}
